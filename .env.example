# Resend (https://resend.com) — transactional email for the quote form.
# Get a key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives new quote requests.
QUOTE_NOTIFICATION_EMAIL=sales@merkabanooks.com

# Sender identity. Until a custom domain is verified in Resend, sending is
# restricted to onboarding@resend.dev and delivery is limited to the email
# address on your Resend account — see the "RFQ / quote submission" section
# in README.md for the full setup walkthrough.
QUOTE_FROM_EMAIL="Merkabanooks <onboarding@resend.dev>"

# Supabase (https://supabase.com) — powers the admin backend: product/category
# database, image storage, and staff login. Without these, the public site
# runs fine off the static catalog in src/lib/categories.ts, but /admin is
# unusable (login will show a "not configured" error).
# Get these from Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin for sitemap.xml, robots.txt and social share previews.
# Defaults to https://merkabanooks.com when unset.
NEXT_PUBLIC_SITE_URL=
